NEXT_PUBLIC_APP_NAME=LUNA CLOUD
NEXT_PUBLIC_APP_TAGLINE=Your PC. Anywhere.

# URL the browser/frontend uses to reach the backend (incl. WebSocket).
BACKEND_URL=http://localhost:3000

# Secret used to sign session tokens. CHANGE THIS in production.
AUTH_SECRET=change-me-in-production
# Single-user private credentials for the web app.
LUNA_USER=owner
LUNA_PASSWORD=change-me

# Secret the runtime agent must present to connect (outbound to backend).
RUNTIME_AUTH_SECRET=runtime-change-me

# Active compute + streaming providers: mock | local | colab  and  vnc | webrtc
COMPUTE_PROVIDER=mock
STREAMING_PROVIDER=vnc

# Persisted application metadata (JSON file store for dev).
DATABASE_URL=file://./data/luna.db.json

# Where persistent storage would live (mounted on Colab when configured).
STORAGE_CONFIG={"enabled":false,"mountPath":"/mnt/luna-persistent"}
STREAMING_CONFIG={"defaultResolution":"1080p","defaultFps":60,"defaultQuality":"balanced"}
