# =====================================================================
# KYRO CLOUD — environment configuration
# Three-tier deployment:  Vercel (frontend) · Render (backend) · Colab (compute)
# Only set the variables relevant to the service you are deploying.
# =====================================================================

# ---- Frontend (Vercel / Next.js) ----
# The browser uses this to reach the backend API + WebSocket.
# On Vercel this MUST point at the Render backend URL, e.g.:
NEXT_PUBLIC_API_URL=https://kyro-cloud-3fp0.onrender.com
# Branding
NEXT_PUBLIC_APP_NAME=KYRO CLOUD
NEXT_PUBLIC_APP_TAGLINE=Your PC. Anywhere.

# ---- Backend (Render) ----
# The Vercel frontend origin. CORS on the backend allows ONLY this origin.
# Never use "*" here — credentials are sent cross-origin.
FRONTEND_URL=https://kyro-cloud.vercel.app
# Secret used to sign session tokens (shared with nothing else).
AUTH_SECRET=change-me-in-production
# Single-user private credentials for the web app.
LUNA_USER=owner
LUNA_PASSWORD=change-me
# Secret the Colab runtime agent must present to connect (/agent WebSocket).
RUNTIME_AUTH_SECRET=runtime-change-me
# Active compute + streaming providers.
COMPUTE_PROVIDER=colab
STREAMING_PROVIDER=vnc

# ---- Cross-service secrets (set IDENTICALLY on Vercel and Render) ----
# Service key the Render backend uses to persist/read provider links from
# Vercel Postgres — enables no-relink persistence across restarts.
BACKEND_SERVICE_KEY=
# Encryption-at-rest key for linked provider credentials. Rotating it
# invalidates every stored secret.
CREDENTIAL_SECRET=

# ---- Compute (Google Colab runtime-agent) ----
# Must equal Render's RUNTIME_AUTH_SECRET above.
LUNA_RUNTIME_AUTH=runtime-change-me
# WebSocket endpoint the Colab agent dials into.
LUNA_BACKEND_WS=wss://kyro-cloud-3fp0.onrender.com/agent

# ---- Optional / dev ----
DATABASE_URL=file://./data/luna.db.json
STORAGE_CONFIG={"enabled":false,"mountPath":"/mnt/luna-persistent"}
STREAMING_CONFIG={"defaultResolution":"1080p","defaultFps":60,"defaultQuality":"balanced"}
