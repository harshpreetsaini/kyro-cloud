{
  "name": "kyro-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "KYRO CLOUD — Your PC. Anywhere. A personal cloud gaming platform.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "backend": "node backend/server.mjs",
    "backend:dev": "NODE_ENV=development node backend/server.mjs",
    "deploy": "docker compose up --build -d",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.mjs"
  },
  "dependencies": {
    "@novnc/novnc": "1.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "jose": "5.9.6",
    "lucide-react": "^1.33.0",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/ws": "8.5.13",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
