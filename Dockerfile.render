# Backend-only image for Render.
# This service must NOT serve the Next.js frontend — it exposes only the
# REST API + WebSocket control plane. The frontend is deployed separately on Vercel.
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

# Only the Node-compatible backend + lib modules are needed.
# The Next.js app/ directory is intentionally excluded.
COPY lib ./lib
COPY backend ./backend

ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "backend/server.mjs"]
